# ============================================================================
# SOFDEV - Variables de entorno
# Copia este archivo como ".env.local" y rellena los valores reales.
# NUNCA subas ".env.local" a Git (ya está en .gitignore).
# ============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # SOLO uso en servidor / Edge Functions, nunca en el cliente

# --- Envío de emails (formulario de contacto) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
CONTACT_EMAIL_TO=contacto@sofdev.com
CONTACT_EMAIL_FROM=no-reply@sofdev.com

# --- Anti-spam / Anti-bot ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# --- Rate limiting (ej. Upstash Redis) ---
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://www.sofdev.com
NEXT_PUBLIC_DEFAULT_LOCALE=es

# --- Google Reviews (opcional, si se automatiza la sincronización) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
